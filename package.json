{
  "name": "coldaisle-telemetry-twin",
  "version": "1.0.0",
  "private": true,
  "description": "Carrier-grade Data Hall Cooling & Power Telemetry Twin for colocation data centers",
  "author": "Antigravity Engineering",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "sim",
    "db"
  ],
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "npm --workspace=db run migrate",
    "db:seed": "npm --workspace=db run seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
