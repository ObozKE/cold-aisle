# ==============================================================================
# ColdAisle DCIM Telemetry Twin - Environment Configuration
# ==============================================================================

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=coldaisle_admin
POSTGRES_PASSWORD=coldaisle_secret_dev
POSTGRES_DB=coldaisle_telemetry
POSTGRES_PORT=5432
DATABASE_URL=postgres://coldaisle_admin:coldaisle_secret_dev@localhost:5432/coldaisle_telemetry

# --- MQTT Broker (Mosquitto) ---
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=dcim/+/+/+/telemetry

# --- Ingest Service (Node.js / Express) ---
NODE_ENV=development
INGEST_PORT=4000
INGEST_API_KEY=dcim_dev_ingest_key_9921
HMAC_WEBHOOK_SECRET=coldaisle_default_hmac_secret_4421
WEBHOOK_MAX_RETRIES=5
STALE_CHECK_INTERVAL_MS=5000
ESCALATION_ACCELERATION=50

# --- Web NOC Dashboard (Next.js 14+) ---
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="Data Hall Cooling & Power Telemetry Twin"
NEXT_PUBLIC_INGEST_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Nairobi
MOCK_ONCALL_SECRET=coldaisle_default_hmac_secret_4421

# --- Node Scenario Simulator ---
SIM_TARGET_PROTOCOL=mqtt
SIM_MQTT_URL=mqtt://localhost:1883
SIM_HTTP_URL=http://localhost:4000/api/v1/ingest
SIM_DEVICE_KEY=dcim_dev_ingest_key_9921
SIM_DEFAULT_SCENARIO=normal
SIM_PUBLISH_INTERVAL_MS=3000

# --- Africa's Talking SMS Adapter (Optional Stub) ---
ENABLE_AFRICASTALKING_SMS=false
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
